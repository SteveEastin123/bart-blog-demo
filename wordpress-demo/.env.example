# Optional local overrides. Copy this file to .env only when different values
# are needed. Never use Bart Ehrman Blog credentials here.
WORDPRESS_PORT=8085
MYSQL_DATABASE=ehrman_wordpress
MYSQL_USER=ehrman
MYSQL_PASSWORD=ehrman-local-only
MYSQL_ROOT_PASSWORD=ehrman-root-local-only
# Leave blank outside controlled parity testing. Supply the token in the
# X-Ehrman-Parity-Token request header when enabled.
EHRMAN_DISCOVERY_PARITY_TOKEN=
# Optional. Enables the local Ask a Question proof of concept.
OPENAI_API_KEY=
EHRMAN_DISCOVERY_AI_MODEL=gpt-5.4-mini
