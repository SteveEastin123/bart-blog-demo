{
    "name": "steveeastin/ehrman-blog-discovery",
    "description": "Development tooling for the Ehrman Blog Discovery WordPress plugin.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "psr-4": {
            "EhrmanBlogDiscovery\\": [
                "src/Core/",
                "src/Browse/",
                "src/KeywordSearch/",
                "src/AskAI/",
                "src/Analytics/",
                "src/Ingestion/",
                "src/Import/",
                "src/Http/",
                "src/Shared/"
            ]
        }
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "check": [
            "@lint",
            "@analyse"
        ],
        "lint": "phpcs -p",
        "lint:fix": "phpcbf -p"
    }
}
