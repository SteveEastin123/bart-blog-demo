includes:
    - ../../../wordpress-plugin/ehrman-blog-discovery/vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 5
    phpVersion: 80100
    tmpDir: /tmp/ehrman-section-public-phpstan
    bootstrapFiles:
        - ../../../wordpress-plugin/ehrman-blog-discovery/phpstan-bootstrap.php
    scanDirectories:
        - ../../../wordpress-plugin/ehrman-blog-discovery/src
        - ../plugin
    scanFiles:
        - ../../../wordpress-plugin/ehrman-blog-discovery/stubs/wp-cli.stub
    paths:
        - plugin
