<?xml version="1.0"?>
<ruleset name="Ehrman Reviewer Tools">
    <file>ehrman-reviewer-tools.php</file>
    <file>src</file>
    <file>phpstan-bootstrap.php</file>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <config name="minimum_supported_wp_version" value="6.5"/>
    <rule ref="WordPress"/>
    <rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
        <exclude-pattern>src/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Files.FileName.InvalidClassFileName">
        <exclude-pattern>src/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="ehrman-reviewer-tools"/>
                <element value="ehrman-blog-discovery"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="EhrmanReviewerTools"/>
                <element value="EHRMAN_REVIEWER"/>
            </property>
        </properties>
    </rule>
</ruleset>
